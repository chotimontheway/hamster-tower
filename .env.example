# Required in production
# Use the POOLED connection string of your Postgres provider
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# A long random string. Changing it signs everyone out
SESSION_SECRET=

# Optional
# REST Redis (Upstash) so request limits are shared between functions
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Protects /api/cron/sync
CRON_SECRET=
# Comma separated sites that may call the API from another address, the hosted static copy of the game by default
# CORS_ORIGINS=https://hamster-tower.identitymd.eth.limo,https://hamster-tower.imd.site
# Lets people play without a wallet
# ALLOW_GUEST=1
# Comma separated wallets that get the test panel on the live site. Nobody else can use it, and the boards show these wallets as Dev, without a rank or an address
# TEST_WALLETS=
# Comma separated Sepolia RPC endpoints, tried in order
SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com,https://sepolia.gateway.tenderly.co,https://sepolia.rpc.thirdweb.com
# Minimum time a battle must take per turn, in milliseconds
MIN_MS_PER_ROUND=700
# The SQK contract (contracts/src/HamsterTowerSQK.sol) and the block it was made in. Without SQK_SHOP the SQK Chest and the pouches stay off
# SQK_SHOP=
# SQK_FROM_BLOCK=
# The key that signs reward claims. When empty it is made from SESSION_SECRET. GET /api/sqk shows its address for the contract
# SQK_SIGNER_KEY=
# Blocks a purchase needs on top before its chest is given, 3 by default
# SQK_CONFIRMATIONS=3
# 1 lets a dev wallet earn and claim SQK to test claims. On by default on a computer, off on the live site unless set
# DEV_SQK=0
# 1 opens social quests to players. Until then the Quests tab says Coming soon
# SOCIAL_QUESTS=1
# Connect X: an app from the X developer portal (OAuth 2.0, confidential client, read only scopes). Without both, connecting X and every
# social check stay off. List a callback for every address the game answers on, for example https://www.hamstertower.site/api/x/callback
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# Leave empty so the callback is the address the player is on, where their sign in cookie lives. Set it only for a game on one address
# X_REDIRECT_URI=
# How many of a player's newest follows a follow check reads, 100 by default. X charges every one read
# X_FOLLOW_PAGE=100
# The post fields a check asks for. The current docs use post.fields and referenced_posts, an older app may need
# tweet.fields=referenced_tweets,conversation_id,created_at,author_id
# X_FIELDS=post.fields=referenced_posts,conversation_id,created_at,author_id

# Local testing only. Never set these in production
# The game on a computer listens on 127.0.0.1 and ::1 and answers only localhost, 127.0.0.1 and [::1]. To reach it from another device
# on a network you trust, listen on all addresses and name the addresses you will type
# HOST=0.0.0.0
# DEV_HOSTS=192.168.1.20
# ALLOW_TRIAL=1
# RATE_LIMIT_OFF=1
# Minutes the coin bonus lasts after a round with work, 30 by default
# LIVE_WINDOW_MIN=30

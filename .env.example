# Required in production
# Use the POOLED connection string of your Postgres provider
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# A long random string. Changing it signs everyone out
SESSION_SECRET=

# Optional
# REST Redis (Upstash) so request limits are shared between functions
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Protects /api/cron/sync
CRON_SECRET=
# Comma separated sites that may call the API from another address, the hosted static copy of the game by default
# CORS_ORIGINS=https://hamster-tower.identitymd.eth.limo,https://hamster-tower.imd.site
# Lets people play without a wallet
# ALLOW_GUEST=1
# Comma separated wallets that get the test panel on the live site. Nobody else can use it, and the boards show these wallets as Dev, without a rank or an address
# TEST_WALLETS=
# Comma separated Sepolia RPC endpoints, tried in order
SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com,https://sepolia.gateway.tenderly.co,https://sepolia.rpc.thirdweb.com
# Minimum time a battle must take per turn, in milliseconds
MIN_MS_PER_ROUND=700

# Local testing only. Never set these in production
# ALLOW_TRIAL=1
# RATE_LIMIT_OFF=1
# Minutes the coin bonus lasts after a round with work, 30 by default
# LIVE_WINDOW_MIN=30
